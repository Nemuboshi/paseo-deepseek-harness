{
  "owner": "Nemuboshi",
  "repo": "Nemuboshi/paseo-deepseek-harness",
  "dsh": {
    "0.2": "~/<path-to>/dsh-0.2/bin/dsh",
    "0.1": "~/<path-to>/dsh-0.1/bin/dsh"
  },
  "patch": "~/.config/paseo-deepseek-harness/dsh-headless.patch.yml",
  "hidePaths": [
    "~/.config/gh",
    "~/.ssh",
    "~/.git-credentials",
    "~/.npmrc",
    "~/.netrc",
    "~/.docker/config.json"
  ],
  "pollSeconds": 60,
  "dshHome": "~/.local/share/paseo-deepseek-harness/dsh-home",
  "credentials": "~/.dsh/.credentials.yaml",
  "app": {
    "id": 123456,
    "privateKeyPath": "~/.config/paseo-deepseek-harness/agent-app.pem"
  }
}
